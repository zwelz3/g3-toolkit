{
  "name": "g3-toolkit",
  "version": "1.0.0",
  "description": "A composable, paradigm-neutral graph visualization toolkit for RDF, LPG, and Holonic architectures.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "gates": "pnpm run typecheck && pnpm run lint && pnpm run verify && pnpm run test && pnpm run gates:spec",
    "gates:spec": "python scripts/lint_specs.py specs/ && python scripts/sync_spec_status.py && python scripts/check_roadmap_coverage.py",
    "dev": "vite",
    "build": "pnpm run build:packages && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:packages": "node scripts/clean-dist.mjs && tsc -b packages/core packages/react packages/charts --force && pnpm --filter \"./packages/*\" --workspace-concurrency=1 run build && node scripts/fix-dts-extensions.mjs",
    "verify:peers": "node scripts/check-optional-peers.mjs",
    "verify:treeshake": "node scripts/verify-treeshake.mjs",
    "verify:smoke": "node scripts/smoke-test.mjs",
    "verify:bundle": "node scripts/check-bundle-size.mjs",
    "verify:consumer-cost": "node scripts/check-consumer-cost.mjs",
    "verify:landing": "node scripts/build-landing.mjs",
    "verify:stats": "node scripts/workspace-stats.mjs",
    "verify": "pnpm run build:packages && pnpm run verify:package && pnpm run verify:typeref && pnpm run verify:exports && pnpm run verify:surface && pnpm run verify:archive && pnpm run verify:peers && pnpm run verify:treeshake && pnpm run verify:smoke && pnpm run verify:types && pnpm run verify:snippets && pnpm run docs:check && pnpm run verify:landing && pnpm run verify:bundle && pnpm run verify:consumer-cost",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "docs:api": "typedoc",
    "docs:check": "typedoc --emit none",
    "docs:storybook": "storybook build -o docs-out/storybook",
    "docs:demo": "vite build --base=/g3-toolkit/playground/ --outDir=docs-out/playground --emptyOutDir",
    "docs:build": "pnpm run docs:api && pnpm run docs:storybook && pnpm run docs:demo && node -e \"const fs=require('fs');fs.copyFileSync('docs/landing.html','docs-out/index.html')\"",
    "verify:types": "node scripts/verify-types.mjs",
    "verify:snippets": "node scripts/check-readme-snippets.mjs",
    "verify:exports": "vitest run --config vitest.dist.config.ts",
    "verify:surface": "node scripts/check-api-surface.mjs",
    "verify:archive": "node scripts/check-archive-accuracy.mjs",
    "storybook-static": "vite build --config vite.sb-client.config.ts && node scripts/storybook-static/inline.mjs",
    "e2e:failures": "node scripts/filter-e2e-failures.mjs",
    "verify:package": "node scripts/check-package-exports.mjs",
    "verify:typeref": "node scripts/check-type-reachability.mjs"
  },
  "dependencies": {
    "@g3t/charts": "workspace:*",
    "@g3t/core": "workspace:*",
    "@g3t/react": "workspace:*",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.1",
    "jsonld": "^9.0.0",
    "n3": "^2.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@dagrejs/dagre": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cytoscape": "^3.21.9",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "cytoscape": ">=3.28.0",
    "cytoscape-fcose": "^2.2.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "echarts": ">=5.0.0",
    "elkjs": "^0.11.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.1",
    "expr-eval": "^2.0.2",
    "globals": "^17.11.0",
    "graphology": "^0.26.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "simple-statistics": "^7.8.9",
    "storybook": "^10.4.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "zustand": ">=4.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
